; Engine configuration file.
config_version=5

[application]

config/name="EchoFragment"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73)]
}
skills={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":79)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Interactables"
